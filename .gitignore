# ==========================================
# AgentOS Monorepo Git Ignore Rules
# ==========================================

# ------------------------------------------
# 1. Dependency Directories & Package Managers
# ------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
web_modules/
.pnpm-store/
.yarn/
.yarn-integrity
.bun/

# ------------------------------------------
# 2. Build & Compilation Outputs
# ------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
release/
**/release/
lib-cov/
*.tsbuildinfo
*.tgz

# ------------------------------------------
# 3. Electron & Desktop Distribution Artifacts
# ------------------------------------------
apps/desktop/dist/
apps/desktop/out/
apps/desktop/release/
dist-electron/
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.snap

# ------------------------------------------
# 4. Logs, Runtime & Diagnostic Reports
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock
*.cpuprofile
*.heapprofile
.node_repl_history

# ------------------------------------------
# 5. Test Coverage, Evals & Temporary Scratch
# ------------------------------------------
coverage/
*.lcov
.nyc_output/
reports/
evals/results/
eval-results/
.test-*
**/.test-*
.tmp-*
**/.tmp-*
scratch/

# ------------------------------------------
# 6. Database & Local Storage
# ------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
sessions.db*
test.db*

# ------------------------------------------
# 7. Environment, Credentials & Local Config
# ------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
agentos.config.json
.agentos/
**/.agentos/

# ------------------------------------------
# 8. Local Reference Repositories & Harnesses
# ------------------------------------------
.freebuff/
.opencode/
.harnesses/
.skillopt/
.skill-optimizer/
prompts/

# ------------------------------------------
# 9. IDEs & Text Editors
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ------------------------------------------
# 10. Framework & Bundler Caches
# ------------------------------------------
.cache/
.parcel-cache/
.turbo/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.eslintcache
.stylelintcache
.next/
.nuxt/
.vuepress/dist/
.vuepress/.temp/
.vuepress/.cache/
.docusaurus/
.serverless/
.fusebox/
.dynamodb/
.tern-port

# ------------------------------------------
# 11. Operating System Generated Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/