{
  "name": "agent-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run --cwd apps/cli build",
    "start": "bun run --cwd apps/cli start",
    "desktop": "bun run --cwd apps/desktop electron",
    "desktop:build": "bun run --cwd apps/desktop build",
    "desktop:open": "bun run --cwd apps/desktop open",
    "desktop:package": "bun run --cwd apps/desktop package",
    "build:bin": "bun run scripts/build-binaries.ts",
    "installer": "bun run scripts/build-inno-installer.ts",
    "installer:inno": "bun run scripts/build-inno-installer.ts",
    "install:local": "powershell -ExecutionPolicy Bypass -File install.ps1",
    "eval": "bun run apps/cli/src/index.ts eval",
    "gate": "bunx tsc --noEmit && bun test && bun run build && bun run eval --task smoke --model fake:scripted",
    "gate:smoke": "bunx tsc --noEmit && bun test && bun run build && bun run eval --task smoke --model fake:scripted",
    "package:dry": "bun run scripts/package-dry-run.ts",
    "release:check": "bunx tsc --noEmit && bun test && bun run build && bun run eval --task smoke --model fake:scripted && bun run package:dry"
  },
  "devDependencies": {
    "bun-types": "^1.1.0",
    "typescript": "^5.0.0"
  }
}